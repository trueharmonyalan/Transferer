{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"],
      "signalingServer/*": ["./signalingServer/*"],
    },
    "rootDir": "..",
    "outDir": "../dist/signalingServer",
    "strict": true,
    "esModuleInterop": true,
  },
  "include": ["src", "../shared"],
}
